{
  "name": "kemfai-api",
  "version": "0.1.0",
  "description": "KEMFAI BFF - NestJS 10. The only customer/staff-facing API boundary (Constitution Principle III).",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:integration": "node test/run-integration-isolated.js",
    "test:integration:nonlive": "jest --config test/jest-integration-nonlive.json",
    "test:integration:t111": "../../scripts/test_t111_integration.sh focused",
    "test:integration:t111:regression": "../../scripts/test_t111_integration.sh regression",
    "test:contract": "jest --config test/jest-contract.json --detectOpenHandles",
    "typeorm": "typeorm-ts-node-commonjs",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "notify:recover": "ts-node src/scripts/recover-billing-decision-notifications.ts",
    "seed:dev": "ts-node src/database/seeds/dev-quickstart.seed.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.22",
    "@nestjs/core": "10.4.22",
    "@nestjs/platform-express": "10.4.22",
    "@nestjs/swagger": "7.4.2",
    "bullmq": "5.81.5",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "jose": "5.10.0",
    "js-yaml": "4.3.2",
    "minio": "8.0.7",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.22",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/js-yaml": "4.0.9",
    "@types/node": "20.19.9",
    "@types/supertest": "6.0.2",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-prettier": "5.2.6",
    "jest": "29.7.0",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.6.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "multer": "2.4.0",
    "body-parser": "1.20.8",
    "lodash": "4.18.1",
    "js-yaml": "4.3.2",
    "file-type": "22.1.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "setupFiles": ["<rootDir>/../test/setup-unit-env.js"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
