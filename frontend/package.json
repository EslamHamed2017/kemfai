{
  "name": "kemfai-frontend",
  "version": "0.1.0",
  "description": "KEMFAI onboarding shell - Next.js 15 App Router, Carbon-based, EN/AR LTR/RTL.",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:integration:auth": "jest --config jest.live-auth.config.js --runInBand",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "generate:api-client": "openapi-typescript ../specs/001-saas-onboarding-shell/contracts/openapi.yaml -o src/lib/api-client/schema.d.ts"
  },
  "dependencies": {
    "@carbon/react": "1.116.0",
    "jose": "5.10.0",
    "next": "15.5.25",
    "next-intl": "4.14.5",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "5.8.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/jest": "30.0.0",
    "@types/node": "20.19.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.25",
    "eslint-config-prettier": "9.1.2",
    "jest": "30.5.1",
    "jest-environment-jsdom": "30.5.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}
