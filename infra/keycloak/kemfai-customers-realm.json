{
  "id": "kemfai-customers",
  "realm": "kemfai-customers",
  "displayName": "KEMFAI Customers",
  "enabled": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8a01",
        "name": "WorkspaceOwner",
        "description": "Workspace Owner with configuration-driven Accounting Foundation permissions, scoped to its own ready tenant.",
        "composite": true,
        "clientRole": false,
        "containerId": "kemfai-customers",
        "composites": {
          "realm": [
            "accounting.coa.view",
            "accounting.coa.create",
            "accounting.coa.edit",
            "accounting.drafts.view",
            "accounting.drafts.edit"
          ]
        }
      },
      {
        "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8a02",
        "name": "accounting.coa.view",
        "description": "Accounting Foundation permission; granted through configured customer role composition.",
        "composite": false,
        "clientRole": false,
        "containerId": "kemfai-customers"
      },
      {
        "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8a03",
        "name": "accounting.coa.create",
        "description": "Accounting Foundation permission; granted through configured customer role composition.",
        "composite": false,
        "clientRole": false,
        "containerId": "kemfai-customers"
      },
      {
        "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8a04",
        "name": "accounting.coa.edit",
        "description": "Accounting Foundation permission; granted through configured customer role composition.",
        "composite": false,
        "clientRole": false,
        "containerId": "kemfai-customers"
      },
      {
        "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8a05",
        "name": "accounting.drafts.view",
        "description": "Accounting Foundation permission; granted through configured customer role composition.",
        "composite": false,
        "clientRole": false,
        "containerId": "kemfai-customers"
      },
      {
        "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8a06",
        "name": "accounting.drafts.edit",
        "description": "Accounting Foundation permission; granted through configured customer role composition.",
        "composite": false,
        "clientRole": false,
        "containerId": "kemfai-customers"
      }
    ]
  },
  "requiredActions": [
    {
      "alias": "VERIFY_EMAIL",
      "name": "Verify Email",
      "providerId": "VERIFY_EMAIL",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    },
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": false,
      "priority": 20,
      "config": {}
    }
  ],
  "clients": [
    {
      "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8b01",
      "clientId": "kemfai-api",
      "name": "KEMFAI API",
      "description": "Public OIDC client for the KEMFAI frontend (Authorization Code + PKCE). Access tokens carry the audience 'kemfai-api', which is what the API/BFF BearerAuthGuard validates (KEYCLOAK_API_AUDIENCE, T010).",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": [
        "http://localhost:3000/auth/callback",
        "http://127.0.0.1:3000/auth/callback",
        "http://localhost:3010/auth/callback",
        "http://127.0.0.1:3010/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000",
        "http://127.0.0.1:3000",
        "http://localhost:3010",
        "http://127.0.0.1:3010"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8b02",
          "name": "kemfai-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "kemfai-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false",
            "multivalued": "false"
          }
        }
      ]
    },
    {
      "id": "9a1f2c34-1b2c-4e3f-8a9b-4c5d6e7f8c01",
      "clientId": "kemfai-users",
      "name": "KEMFAI user provisioner",
      "description": "T096 least-privilege service account used only by the API account lifecycle integration.",
      "enabled": true,
      "publicClient": false,
      "bearerOnly": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${KEYCLOAK_USERS_CLIENT_SECRET}",
      "protocol": "openid-connect",
      "fullScopeAllowed": false
    }
  ],
  "users": [
    {
      "username": "service-account-kemfai-users",
      "enabled": true,
      "serviceAccountClientId": "kemfai-users",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-realm"
        ]
      }
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "kemfai-users",
        "roles": [
          "manage-users",
          "view-realm"
        ]
      }
    ]
  }
}
