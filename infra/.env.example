# KEMFAI environment template - copy to .env and fill

# --- Odoo / Postgres (dev) ---
ODOO_MASTER_PASSWORD=kemfai_dev_master
PG_USER=odoo
PG_PASSWORD=kemfai_dev_pg
PG_HOST=kemfai-db
PG_PORT=5432

# --- KEMFAI API / BFF ---
KEMFAI_API_PORT=4000
KEMFAI_ODOO_URL=http://kemfai-odoo:8069
NODE_ENV=development

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Redis / BullMQ (infra/docker/docker-compose.yml) ---
REDIS_URL=redis://redis:6379

# --- Auth (Keycloak, self-hosted - plan.md tech stack decision) ---
AUTH_PROVIDER=keycloak
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=kemfai_dev_admin
# Customer-facing realm (data-model.md); the API validates every bearer token's iss/aud against
# these (BearerAuthGuard, T010) - a token signed for another realm/client is rejected outright.
KEYCLOAK_CUSTOMERS_REALM=kemfai-customers
KEYCLOAK_API_AUDIENCE=kemfai-api
KEYCLOAK_PUBLIC_ORIGIN=http://localhost:8080
KEYCLOAK_ISSUER=http://localhost:8080/realms/kemfai-customers
# User provisioning (T032 POST /accounts/signup creates kemfai-customers users via the Admin
# REST API). Production: a scoped service client (client_credentials). Dev: the bootstrap
# admin credentials above are used via admin-cli when no service client is configured.
# KEYCLOAK_USERS_CLIENT_ID=kemfai-api-admin
# KEYCLOAK_USERS_CLIENT_SECRET=
# Frontend duplicate-email recovery actions (T037, Acceptance Scenario 1.6): the /login and
# /reset-password route handlers redirect here. Deployment config only - never hard-code a
# host or realm name in the frontend. Left unset in dev; the handlers show a localized
# "temporarily unavailable" message instead of a dead link when empty.
# KEYCLOAK_CUSTOMERS_LOGIN_URL=
# KEYCLOAK_CUSTOMERS_RESET_PASSWORD_URL=

# --- File storage (MinIO, self-hosted - plan.md tech stack decision) ---
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=http://minio:9000
STORAGE_CONSOLE_URL=http://minio:9001
STORAGE_KEY=kemfai_minio
STORAGE_SECRET=kemfai_dev_minio_secret

# --- AI (Ask KEMFAI V1) ---
KEMFAI_AI_PROVIDER=omniroute
KEMFAI_AI_BASE_URL=https://omniroute.basetaa.com/v1
KEMFAI_AI_KEY=

# Required for tenant provisioning; set these to deployment-specific non-empty secrets.
KEMFAI_ODOO_MASTER_PASSWORD=
KEMFAI_TENANT_ADMIN_LOGIN=
KEMFAI_TENANT_ADMIN_PASSWORD=
