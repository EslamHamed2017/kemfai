# KEMFAI environment template - copy to .env and fill

# --- Odoo / Postgres (dev) ---
ODOO_MASTER_PASSWORD=kemfai_dev_master
PG_USER=odoo
PG_PASSWORD=kemfai_dev_pg
PG_HOST=kemfai-db
PG_PORT=5432

# --- KEMFAI API / BFF ---
KEMFAI_API_PORT=4000
KEMFAI_ODOO_URL=http://kemfai-odoo:8069
NODE_ENV=development

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# --- Auth (Gate 0 decision - TBD) ---
AUTH_PROVIDER=
AUTH_ISSUER_URL=
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# --- File storage (Gate 0 decision - TBD) ---
STORAGE_PROVIDER=
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_KEY=
STORAGE_SECRET=

# --- AI (Ask KEMFAI V1) ---
KEMFAI_AI_PROVIDER=omniroute
KEMFAI_AI_BASE_URL=https://omniroute.basetaa.com/v1
KEMFAI_AI_KEY=
